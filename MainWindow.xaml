<Window x:Class="MediaForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaForge"
        Width="1320" Height="880" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Padding="6,2"
              AutomationProperties.Name="MediaForge application menu">
            <MenuItem Header="_File">
                <MenuItem Header="_Add Media..." Click="AddFiles_Click"/>
                <MenuItem Header="Add _Folder..." Click="AddFolder_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Remove selected" Click="RemoveSelected_Click"/>
                <MenuItem Header="_Clear media list" Click="Clear_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Home" Click="ShowHome_Click"/>
                <MenuItem Header="_Current task" Click="ShowTaskWorkspace_Click"/>
                <MenuItem Header="_Advanced controls" Click="OpenAdvancedWorkspace_Click"/>
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="_New" Click="NewProject_Click"/>
                <MenuItem Header="_Open..." Click="OpenProject_Click"/>
                <MenuItem Header="_Recent" Click="RecentProjects_Click"/>
                <Separator/>
                <MenuItem Header="_Save" Click="SaveProject_Click"/>
                <MenuItem Header="Save _As..." Click="SaveProjectAs_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Presets..." Click="PresetManager_Click"/>
                <MenuItem Header="_Advanced workspace" Click="OpenAdvancedWorkspace_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Getting started" Click="GettingStarted_Click"/>
                <MenuItem Header="_About MediaForge" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="HomeShell"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="MediaForge Home">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel MaxWidth="980" HorizontalAlignment="Center">
                        <TextBlock Text="MediaForge"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,6"/>
                        <TextBlock Text="What do you want to do?"
                                   FontSize="22"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Add media, choose a task, review the result, then process. Projects are optional."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                MaxWidth="980"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Margin="0,26,0,22">
                        <Button x:Name="HomeAddMediaButton"
                                Content="Add Media"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="170"
                                MinHeight="46"
                                Click="AddFiles_Click"
                                AutomationProperties.Name="Add Media"
                                AutomationProperties.HelpText="Choose one or more image, video or audio files to work with."/>
                        <Button Content="Add Folder"
                                MinWidth="125"
                                MinHeight="46"
                                Click="AddFolder_Click"
                                AutomationProperties.Name="Add Folder"
                                AutomationProperties.HelpText="Add supported media from a folder and its subfolders."/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            MaxWidth="980"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding Shell.MediaSummary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Shell.StateDisplay}"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0"
                                       AutomationProperties.Name="Workflow status"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="3"
                               MaxWidth="1000"
                               HorizontalAlignment="Center"
                               ItemWidth="188"
                               ItemHeight="118">
                        <Button Tag="Convert"
                                Click="V2Task_Click"
                                Margin="6"
                                Padding="14"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                AutomationProperties.Name="Convert"
                                AutomationProperties.HelpText="Change media format using a simple conversion workflow.">
                            <StackPanel>
                                <TextBlock Text="Convert" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Change format with normal choices first."
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="Resize"
                                Click="V2Task_Click"
                                Margin="6"
                                Padding="14"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                AutomationProperties.Name="Resize"
                                AutomationProperties.HelpText="Change image or video dimensions without requiring codec knowledge.">
                            <StackPanel>
                                <TextBlock Text="Resize" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Change size and fit behaviour."
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="CropResize"
                                Click="V2Task_Click"
                                Margin="6"
                                Padding="14"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                AutomationProperties.Name="Crop and Resize"
                                AutomationProperties.HelpText="Choose a crop and target size with explicit geometry.">
                            <StackPanel>
                                <TextBlock Text="Crop &amp; Resize" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Reframe, then choose the target size."
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="TrimSplit"
                                Click="V2Task_Click"
                                Margin="6"
                                Padding="14"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                AutomationProperties.Name="Trim or Split"
                                AutomationProperties.HelpText="Keep a time range or create split segments.">
                            <StackPanel>
                                <TextBlock Text="Trim / Split" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Keep ranges or create segments."
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="Combine"
                                Click="V2Task_Click"
                                Margin="6"
                                Padding="14"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                AutomationProperties.Name="Combine"
                                AutomationProperties.HelpText="Arrange compatible media into one ordered result.">
                            <StackPanel>
                                <TextBlock Text="Combine" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Arrange media into one ordered result."
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Grid.Row="4"
                               MaxWidth="980"
                               HorizontalAlignment="Center"
                               Text="You can start without creating a project. Save a project only when you want to keep the workflow for later."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,18,0,30"/>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="TaskShell"
                  Visibility="Collapsed"
                  Margin="24"
                  AutomationProperties.Name="MediaForge task workspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <Button Content="← Home"
                                Click="ShowHome_Click"
                                Margin="0,0,0,14"
                                AutomationProperties.Name="Back to Home"/>
                        <TextBlock Text="Tasks"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,8"/>
                        <Button Content="Convert" Tag="Convert" Click="V2Task_Click"
                                Margin="0,0,0,6" AutomationProperties.Name="Convert task"/>
                        <Button Content="Resize" Tag="Resize" Click="V2Task_Click"
                                Margin="0,0,0,6" AutomationProperties.Name="Resize task"/>
                        <Button Content="Crop &amp; Resize" Tag="CropResize" Click="V2Task_Click"
                                Margin="0,0,0,6" AutomationProperties.Name="Crop and Resize task"/>
                        <Button Content="Trim / Split" Tag="TrimSplit" Click="V2Task_Click"
                                Margin="0,0,0,6" AutomationProperties.Name="Trim or Split task"/>
                        <Button Content="Combine" Tag="Combine" Click="V2Task_Click"
                                Margin="0,0,0,6" AutomationProperties.Name="Combine task"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Media  →  Task  →  Configure  →  Review  →  Output  →  Process  →  Result"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding Shell.TaskTitle}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Shell.TaskGuidance}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected media"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Shell.MediaSummary}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Shell.StateDisplay}"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,3,0,0"
                                               AutomationProperties.Name="Workflow status"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="TaskAddMediaButton"
                                            Content="Add Media"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="AddFiles_Click"
                                            AutomationProperties.Name="Add Media"
                                            AutomationProperties.HelpText="Add media to the current task."/>
                                    <Button Content="Add Folder"
                                            Click="AddFolder_Click"
                                            Margin="0"
                                            AutomationProperties.Name="Add Folder"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,14"
                                AutomationProperties.Name="Shared workflow frame">
                            <StackPanel>
                                <TextBlock Text="Workflow state"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Shell.StateTitle}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Shell.StateDetail}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,14"/>

                                <Separator Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource PanelBrush}"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Configure"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Normal task controls belong here. PH-22 provides the shared frame without inventing task-specific processing settings."
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource PanelBrush}"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Review"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="The same frame supports decision and review-ready states before later phases add resolved task summaries."
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4"
                                            Background="{StaticResource PanelBrush}"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Output → Process → Result"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Execution remains owned by the existing runtime until the typed PH-23 plan seam is implemented."
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="AdvancedControlsExpander"
                                  Header="Advanced controls"
                                  IsExpanded="False"
                                  Margin="0,0,0,14"
                                  AutomationProperties.Name="Advanced controls"
                                  AutomationProperties.HelpText="Reveal access to the existing technical workspace when you need detailed controls.">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Technical controls are kept separate from the normal task flow."
                                               TextWrapping="Wrap"/>
                                    <Button Content="Open advanced workspace"
                                            Click="OpenAdvancedWorkspace_Click"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            AutomationProperties.Name="Open advanced workspace"
                                            AutomationProperties.HelpText="Open the existing detailed queue, project, FFmpeg and conversion controls."/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <TextBlock Text="Review, output and processing actions will use this same task frame as each workflow is implemented. The existing processing engine remains unchanged in this shell phase."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
    <Grid x:Name="LegacyWorkspaceGrid" Margin="14" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="390"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="NewProjectButton" Content="New project" Click="NewProject_Click"/>
                    <Button x:Name="OpenProjectButton" Content="Open" Click="OpenProject_Click"/>
                    <Button x:Name="RecentProjectsButton" Content="Recent" Click="RecentProjects_Click"/>
                    <Button x:Name="SaveProjectButton" Content="Save" Click="SaveProject_Click"/>
                    <Button x:Name="SaveProjectAsButton" Content="Save as" Click="SaveProjectAs_Click"/>
                    <Button x:Name="RelinkMissingButton" Content="Relink missing" Click="RelinkMissing_Click" IsEnabled="False"/>
                    <CheckBox x:Name="PortableProjectCheck" Content="Portable paths" VerticalAlignment="Center"
                              Checked="ProjectOptionChanged" Unchecked="ProjectOptionChanged" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ProjectStatusText" Text="Unsaved project" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                           Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="AddFilesButton" Content="Add files" Click="AddFiles_Click"/>
                    <Button x:Name="AddFolderButton" Content="Add folder" Click="AddFolder_Click"/>
                    <Button x:Name="RemoveButton" Content="Remove selected" Click="RemoveSelected_Click"/>
                    <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click"/>
                    <Button x:Name="PreviewEditButton" Content="Preview &amp; edit" Click="PreviewEdit_Click" IsEnabled="False"/>
                    <Button x:Name="ClearEditsButton" Content="Clear edits" Click="ClearEdits_Click" IsEnabled="False"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryButton" Content="Retry selected" Click="RetrySelected_Click"/>
                    <Button x:Name="StartButton" Content="Start batch" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
                    <Button x:Name="PauseButton" Content="Pause after current" IsEnabled="False" Click="PauseResume_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click" Margin="0"/>
                </StackPanel>
                <StackPanel Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="MediaForge" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="One queue for images, video and audio" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Global preset" VerticalAlignment="Center" Margin="4,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="PresetCombo" Width="220" SelectionChanged="PresetCombo_SelectionChanged" Margin="0,0,6,4"/>
                <Button x:Name="ApplyPresetButton" Content="Apply preset to selected" Click="ApplyPresetToSelected_Click"/>
                <Button x:Name="PresetManagerButton" Content="Presets…" Click="PresetManager_Click"/>
                <Button x:Name="ApplyOverrideButton" Content="Current settings → job" Click="ApplyCurrentOverrides_Click"/>
                <Button x:Name="ClearJobOptionsButton" Content="Clear job options" Click="ClearJobOptions_Click"/>
                <Separator Width="12" Opacity="0"/>
                <Button x:Name="MoveUpButton" Content="Up" Click="MoveSelectedUp_Click"/>
                <Button x:Name="MoveDownButton" Content="Down" Click="MoveSelectedDown_Click"/>
                <Button x:Name="PriorityUpButton" Content="Priority +" Click="PriorityUp_Click"/>
                <Button x:Name="PriorityDownButton" Content="Priority −" Click="PriorityDown_Click"/>
                <Button x:Name="ToggleEnabledButton" Content="Enable / disable" Click="ToggleEnabled_Click"/>
                <Button x:Name="DuplicateSelectedButton" Content="Duplicate" Click="DuplicateSelected_Click"/>
                <Button x:Name="OpenSourceButton" Content="Open source" Click="OpenSource_Click"/>
                <Button x:Name="OpenOutputButton" Content="Open output" Click="OpenOutput_Click"/>
                <Button x:Name="CopyDiagnosticButton" Content="Copy summary" Click="CopyDiagnostic_Click"/>
                <Button x:Name="SaveQueueButton" Content="Save queue" Click="SaveQueue_Click"/>
                <Button x:Name="LoadQueueButton" Content="Load queue" Click="LoadQueue_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      SelectionChanged="JobsGrid_SelectionChanged" MouseDoubleClick="JobsGrid_MouseDoubleClick"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                      CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding KindDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledDisplay}" Width="75"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityDisplay}" Width="65"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StateDisplay}" Width="115"/>
                    <DataGridTextColumn Header="Preset" Binding="{Binding SelectedPresetName}" Width="150"/>
                    <DataGridTextColumn Header="Effective options" Binding="{Binding EffectiveOptionsSummary}" Width="220"/>
                    <DataGridTextColumn Header="Estimate" Binding="{Binding EstimateDisplay}" Width="170"/>
                    <DataGridTextColumn Header="Edits" Binding="{Binding EditSummary}" Width="2*"/>
                    <DataGridTemplateColumn Header="Progress" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="16"/>
                                    <TextBlock Text="{Binding ProgressDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Output / message" Binding="{Binding Message}" Width="3*"/>
                    <DataGridTextColumn Header="Source folder" Binding="{Binding Folder}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <TabControl x:Name="OptionsTabs">
                <TabItem Header="Output &amp; FFmpeg">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Output" Grid.Column="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="OutputBesideSourceCheck" Grid.Row="0" Grid.ColumnSpan="3"
                                              Content="Save beside each source file" Margin="0,0,0,8" Checked="OutputModeChanged" Unchecked="OutputModeChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Output folder" VerticalAlignment="Center"/>
                                    <TextBox x:Name="OutputFolderText" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseOutput_Click" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Filename suffix" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SuffixText" Grid.Row="2" Grid.Column="1" Margin="0,0,8,6"/>
                                    <ComboBox x:Name="CollisionCombo" Grid.Row="2" Grid.Column="2" Width="110" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Rename" Tag="Rename"/>
                                        <ComboBoxItem Content="Overwrite" Tag="Overwrite"/>
                                        <ComboBoxItem Content="Skip" Tag="Skip"/>
                                    </ComboBox>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,6">
                                        <CheckBox x:Name="PreserveTreeCheck" Content="Preserve folder tree" Margin="0,0,18,0"/>
                                        <CheckBox x:Name="PreserveTimestampsCheck" Content="Preserve timestamps" Margin="0,0,18,0"/>
                                        <CheckBox x:Name="StripMetadataCheck" Content="Strip metadata"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal">
                                        <TextBlock Text="Parallel jobs" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ParallelJobsCombo" Width="75">
                                            <ComboBoxItem Content="1" Tag="1"/>
                                            <ComboBoxItem Content="2" Tag="2"/>
                                            <ComboBoxItem Content="3" Tag="3"/>
                                            <ComboBoxItem Content="4" Tag="4"/>
                                            <ComboBoxItem Content="6" Tag="6"/>
                                            <ComboBoxItem Content="8" Tag="8"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="FFmpeg tools" Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ffmpeg.exe" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FfmpegPathText" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="BrowseFfmpeg_Click" Margin="0,0,0,6"/>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,8">
                                        <Button Content="Auto-detect" Click="DetectFfmpeg_Click"/>
                                        <Button Content="Download tools" Click="DownloadFfmpeg_Click"/>
                                        <Button Content="Test" Click="TestFfmpeg_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FfmpegStatusText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Text="FFmpeg is required for conversion. Use Auto-detect, browse to ffmpeg.exe, or download a local copy."/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Images">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="Format and compression" Grid.Column="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Output format" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ImageFormatCombo" Grid.Column="1" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="JPEG" Tag="JPEG"/>
                                        <ComboBoxItem Content="PNG" Tag="PNG"/>
                                        <ComboBoxItem Content="WebP" Tag="WebP"/>
                                        <ComboBoxItem Content="AVIF" Tag="AVIF"/>
                                        <ComboBoxItem Content="TIFF" Tag="TIFF"/>
                                        <ComboBoxItem Content="BMP" Tag="BMP"/>
                                        <ComboBoxItem Content="GIF" Tag="GIF"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Quality" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ImageQualitySlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=ImageQualitySlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Resize" Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Placement" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ImageResizeModeCombo" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                        <ComboBoxItem Content="No resize" Tag="None"/>
                                        <ComboBoxItem Content="Centre, no scale" Tag="Center"/>
                                        <ComboBoxItem Content="Fit with padding" Tag="Fit"/>
                                        <ComboBoxItem Content="Stretch to fill" Tag="Stretch"/>
                                        <ComboBoxItem Content="Shrink only" Tag="Shrink"/>
                                        <ComboBoxItem Content="Fill and crop" Tag="Crop"/>
                                        <ComboBoxItem Content="Percentage" Tag="Percent"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Aspect ratio" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ImageAspectRatioCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" SelectionChanged="ImageAspectRatio_SelectionChanged">
                                        <ComboBoxItem Content="Free" Tag="Free"/>
                                        <ComboBoxItem Content="Source" Tag="Source"/>
                                        <ComboBoxItem Content="1:1" Tag="1:1"/>
                                        <ComboBoxItem Content="4:3" Tag="4:3"/>
                                        <ComboBoxItem Content="3:4" Tag="3:4"/>
                                        <ComboBoxItem Content="5:4" Tag="5:4"/>
                                        <ComboBoxItem Content="4:5" Tag="4:5"/>
                                        <ComboBoxItem Content="3:2" Tag="3:2"/>
                                        <ComboBoxItem Content="2:3" Tag="2:3"/>
                                        <ComboBoxItem Content="16:10" Tag="16:10"/>
                                        <ComboBoxItem Content="16:9" Tag="16:9"/>
                                        <ComboBoxItem Content="9:16" Tag="9:16"/>
                                        <ComboBoxItem Content="18:9" Tag="18:9"/>
                                        <ComboBoxItem Content="21:9" Tag="21:9"/>
                                        <ComboBoxItem Content="2.39:1" Tag="2.39:1"/>
                                        <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="Width" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ImageWidthText" Grid.Row="2" Grid.Column="1" Margin="0,0,12,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Height" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ImageHeightText" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Text="Custom ratio" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ImageCustomAspectPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                        <TextBox x:Name="ImageCustomAspectWidthText" Width="65"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox x:Name="ImageCustomAspectHeightText" Width="65"/>
                                        <Button Content="Apply ratio" Click="ApplyImageAspect_Click" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Text="Scale %" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ImagePercentText" Grid.Row="4" Grid.Column="1"/>
                                    <Button Grid.Row="4" Grid.Column="3" Content="Apply ratio" Click="ApplyImageAspect_Click" Margin="0"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Video">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="Container and codec" Grid.Column="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Container" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoContainerCombo" Grid.Column="1" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="MP4" Tag="MP4"/>
                                        <ComboBoxItem Content="MKV" Tag="MKV"/>
                                        <ComboBoxItem Content="WebM" Tag="WebM"/>
                                        <ComboBoxItem Content="MOV" Tag="MOV"/>
                                        <ComboBoxItem Content="AVI" Tag="AVI"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Video codec" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoCodecCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                        <ComboBoxItem Content="H.264 (x264)" Tag="H.264"/>
                                        <ComboBoxItem Content="H.265 / HEVC" Tag="H.265"/>
                                        <ComboBoxItem Content="AV1" Tag="AV1"/>
                                        <ComboBoxItem Content="VP9" Tag="VP9"/>
                                        <ComboBoxItem Content="MPEG-4" Tag="MPEG4"/>
                                        <ComboBoxItem Content="Copy stream" Tag="Copy"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="CRF / quality" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="VideoCrfSlider" Minimum="0" Maximum="51" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=VideoCrfSlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="Preset" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoPresetCombo" Grid.Row="3" Grid.Column="1">
                                        <ComboBoxItem Content="ultrafast" Tag="ultrafast"/>
                                        <ComboBoxItem Content="veryfast" Tag="veryfast"/>
                                        <ComboBoxItem Content="faster" Tag="faster"/>
                                        <ComboBoxItem Content="fast" Tag="fast"/>
                                        <ComboBoxItem Content="medium" Tag="medium"/>
                                        <ComboBoxItem Content="slow" Tag="slow"/>
                                        <ComboBoxItem Content="slower" Tag="slower"/>
                                        <ComboBoxItem Content="veryslow" Tag="veryslow"/>
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Resolution and frame rate" Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Resolution" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoResolutionCombo" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="720p" Tag="720p"/>
                                        <ComboBoxItem Content="1080p" Tag="1080p"/>
                                        <ComboBoxItem Content="1440p" Tag="1440p"/>
                                        <ComboBoxItem Content="4K UHD" Tag="2160p"/>
                                        <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Placement" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoResizeModeCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Centre, no scale" Tag="Center"/>
                                        <ComboBoxItem Content="Fit with padding" Tag="Fit"/>
                                        <ComboBoxItem Content="Stretch to fill" Tag="Stretch"/>
                                        <ComboBoxItem Content="Shrink only" Tag="Shrink"/>
                                        <ComboBoxItem Content="Fill and crop" Tag="Crop"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="Aspect ratio" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoAspectRatioCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" SelectionChanged="VideoAspectRatio_SelectionChanged">
                                        <ComboBoxItem Content="Free" Tag="Free"/>
                                        <ComboBoxItem Content="Source" Tag="Source"/>
                                        <ComboBoxItem Content="1:1" Tag="1:1"/>
                                        <ComboBoxItem Content="4:3" Tag="4:3"/>
                                        <ComboBoxItem Content="3:4" Tag="3:4"/>
                                        <ComboBoxItem Content="5:4" Tag="5:4"/>
                                        <ComboBoxItem Content="4:5" Tag="4:5"/>
                                        <ComboBoxItem Content="3:2" Tag="3:2"/>
                                        <ComboBoxItem Content="2:3" Tag="2:3"/>
                                        <ComboBoxItem Content="16:10" Tag="16:10"/>
                                        <ComboBoxItem Content="16:9" Tag="16:9"/>
                                        <ComboBoxItem Content="9:16" Tag="9:16"/>
                                        <ComboBoxItem Content="18:9" Tag="18:9"/>
                                        <ComboBoxItem Content="21:9" Tag="21:9"/>
                                        <ComboBoxItem Content="2.39:1" Tag="2.39:1"/>
                                        <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Text="Width" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VideoWidthText" Grid.Row="3" Grid.Column="1" Margin="0,0,10,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Height" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VideoHeightText" Grid.Row="3" Grid.Column="3" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="4" Text="Custom ratio" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="VideoCustomAspectPanel" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                                        <TextBox x:Name="VideoCustomAspectWidthText" Width="55"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="VideoCustomAspectHeightText" Width="55"/>
                                        <Button Content="Apply ratio" Click="ApplyVideoAspect_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" Text="Frame rate" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoFpsCombo" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="24 fps" Tag="24"/>
                                        <ComboBoxItem Content="30 fps" Tag="30"/>
                                        <ComboBoxItem Content="60 fps" Tag="60"/>
                                        <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="6" Text="Custom fps" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VideoCustomFpsText" Grid.Row="6" Grid.Column="1"/>
                                    <Button Grid.Row="6" Grid.Column="3" Content="Apply ratio" Click="ApplyVideoAspect_Click" Margin="0"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Video audio" Grid.Column="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Audio codec" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoAudioCodecCombo" Grid.Column="1" Margin="0,0,0,6">
                                        <ComboBoxItem Content="AAC" Tag="AAC"/>
                                        <ComboBoxItem Content="Opus" Tag="Opus"/>
                                        <ComboBoxItem Content="MP3" Tag="MP3"/>
                                        <ComboBoxItem Content="Copy stream" Tag="Copy"/>
                                        <ComboBoxItem Content="Remove audio" Tag="None"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Bitrate kbps" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VideoAudioBitrateText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ExtractAudioCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="Extract audio only using Audio tab settings" Margin="0,4,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                               Text="Copy mode cannot be combined with resizing or frame-rate changes. AV1 and VP9 require compatible FFmpeg encoder builds."/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Audio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="Format and compression" Grid.Column="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Output format" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AudioFormatCombo" Grid.Column="1" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="MP3" Tag="MP3"/>
                                        <ComboBoxItem Content="AAC" Tag="AAC"/>
                                        <ComboBoxItem Content="M4A" Tag="M4A"/>
                                        <ComboBoxItem Content="FLAC" Tag="FLAC"/>
                                        <ComboBoxItem Content="WAV" Tag="WAV"/>
                                        <ComboBoxItem Content="Ogg Vorbis" Tag="OGG"/>
                                        <ComboBoxItem Content="Opus" Tag="OPUS"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Bitrate kbps" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AudioBitrateText" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Processing" Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sample rate" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AudioSampleRateCombo" Grid.Column="1" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="44.1 kHz" Tag="44100"/>
                                        <ComboBoxItem Content="48 kHz" Tag="48000"/>
                                        <ComboBoxItem Content="96 kHz" Tag="96000"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="Channels" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AudioChannelsCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Keep original" Tag="Keep"/>
                                        <ComboBoxItem Content="Mono" Tag="1"/>
                                        <ComboBoxItem Content="Stereo" Tag="2"/>
                                    </ComboBox>
                                    <CheckBox x:Name="AudioNormalizeCheck" Grid.Row="2" Grid.ColumnSpan="2"
                                              Content="Normalize loudness to -14 LUFS (one-pass EBU R128)"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Log">
                    <Grid Margin="8">
                        <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar x:Name="OverallProgress" Height="12" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}"/>
                <TextBlock x:Name="SummaryText" Text="{Binding SummaryText}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <TextBlock x:Name="TotalsText" Text="{Binding TotalsText}" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
        </Grid>
    </Grid>
</Window>
