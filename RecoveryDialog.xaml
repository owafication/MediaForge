<Window x:Class="MediaForge.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover MediaForge work"
        Width="700" Height="420" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="MediaForge found recovery snapshots newer than their last manual save. Select one snapshot, then recover it, open it read-only, discard it, or inspect its folder."/>
        <ListBox x:Name="SnapshotsList" Grid.Row="1" DisplayMemberPath="DisplayName"/>
        <TextBlock x:Name="DetailsText" Grid.Row="2" Margin="0,10,0,10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Inspect folder" Click="Inspect_Click"/>
            <Button Content="Discard" Click="Discard_Click"/>
            <Button Content="Open read-only" Click="OpenReadOnly_Click"/>
            <Button Content="Recover" Style="{StaticResource PrimaryButton}" Click="Recover_Click"/>
            <Button Content="Later" Click="Later_Click" Margin="0"/>
        </WrapPanel>
    </Grid>
</Window>
