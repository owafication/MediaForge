<Window x:Class="MediaForge.MediaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="MediaForge — Preview and edit"
        Width="1480" Height="920" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Placement" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ResizeModeCombo" Grid.Column="1" SelectionChanged="ResizeModeCombo_SelectionChanged">
                    <ComboBoxItem Content="Centre, no scale" Tag="Center"/>
                    <ComboBoxItem Content="Fit with padding" Tag="Fit"/>
                    <ComboBoxItem Content="Stretch to fill" Tag="Stretch"/>
                    <ComboBoxItem Content="Shrink only" Tag="Shrink"/>
                    <ComboBoxItem Content="Fill and crop" Tag="Crop"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Aspect" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <ComboBox x:Name="AspectRatioCombo" Grid.Column="3" SelectionChanged="AspectRatioCombo_SelectionChanged">
                    <ComboBoxItem Content="Free" Tag="Free"/>
                    <ComboBoxItem Content="Source" Tag="Source"/>
                    <ComboBoxItem Content="1:1" Tag="1:1"/>
                    <ComboBoxItem Content="4:3" Tag="4:3"/>
                    <ComboBoxItem Content="3:4" Tag="3:4"/>
                    <ComboBoxItem Content="5:4" Tag="5:4"/>
                    <ComboBoxItem Content="4:5" Tag="4:5"/>
                    <ComboBoxItem Content="3:2" Tag="3:2"/>
                    <ComboBoxItem Content="2:3" Tag="2:3"/>
                    <ComboBoxItem Content="16:10" Tag="16:10"/>
                    <ComboBoxItem Content="16:9" Tag="16:9"/>
                    <ComboBoxItem Content="9:16" Tag="9:16"/>
                    <ComboBoxItem Content="18:9" Tag="18:9"/>
                    <ComboBoxItem Content="21:9" Tag="21:9"/>
                    <ComboBoxItem Content="2.39:1" Tag="2.39:1"/>
                    <ComboBoxItem Content="Custom" Tag="Custom"/>
                </ComboBox>
                <TextBlock Grid.Column="4" Text="Width" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBox x:Name="TargetWidthText" Grid.Column="5"/>
                <TextBlock Grid.Column="6" Text="Height" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBox x:Name="TargetHeightText" Grid.Column="7"/>
                <Button Grid.Column="8" Content="Apply ratio" Click="ApplyRatio_Click" Margin="10,0,0,0"/>
                <StackPanel x:Name="CustomAspectPanel" Grid.Column="9" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                    <TextBox x:Name="CustomAspectWidthText" Width="48" ToolTip="Custom ratio width"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                    <TextBox x:Name="CustomAspectHeightText" Width="48" ToolTip="Custom ratio height"/>
                </StackPanel>
                <CheckBox x:Name="LockSelectionAspectCheck" Grid.Column="10" Content="Keep selection aspect ratio"
                          VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ClipColumn" Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True" Background="#111111" SizeChanged="PreviewCanvas_SizeChanged">
                            <Grid x:Name="MediaHost" Canvas.Left="0" Canvas.Top="0">
                                <Image x:Name="ImagePreview" Stretch="Fill" Visibility="Collapsed"/>
                                <MediaElement x:Name="VideoPreview" Stretch="Fill" Visibility="Collapsed"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                              MediaOpened="VideoPreview_MediaOpened" MediaEnded="VideoPreview_MediaEnded"
                                              MediaFailed="VideoPreview_MediaFailed"/>
                            </Grid>
                            <Grid x:Name="SelectionBox" Canvas.Left="0" Canvas.Top="0" Width="100" Height="100">
                                <Border BorderBrush="#FFEA00" BorderThickness="2" Background="#10FFFFFF"
                                        MouseLeftButtonDown="Selection_MouseLeftButtonDown"
                                        MouseMove="Selection_MouseMove"
                                        MouseLeftButtonUp="Selection_MouseLeftButtonUp"/>
                                <primitives:Thumb Tag="N" Width="28" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="S" Width="28" Height="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNS" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="W" Width="10" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="E" Width="10" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeWE" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="NW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="NE" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="SW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ResizeThumb_DragDelta"/>
                                <primitives:Thumb Tag="SE" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta"/>
                            </Grid>
                        </Canvas>
                        <TextBlock x:Name="PreviewStatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" Background="#99000000" Padding="12,7" TextWrapping="Wrap"
                                   MaxWidth="620" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border x:Name="TimelinePanel" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⏮ 5s" Click="SkipBack5_Click"/>
                            <Button Content="−1s" Click="SkipBack1_Click"/>
                            <Button Content="◀ frame" Click="PreviousFrame_Click"/>
                            <Button x:Name="PlayPauseButton" Content="Play" Style="{StaticResource PrimaryButton}" Click="PlayPause_Click"/>
                            <Button Content="frame ▶" Click="NextFrame_Click"/>
                            <Button Content="+1s" Click="SkipForward1_Click"/>
                            <Button Content="5s ⏭" Click="SkipForward5_Click"/>
                            <CheckBox x:Name="PlaySequenceCheck" Content="Play through clips" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Text="00:00:00.000" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged"
                                    PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp"/>
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00.000" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ClipPanel" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Clips" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Add" Click="AddClips_Click"/>
                            <Button Content="Remove" Click="RemoveClip_Click" Margin="0"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ClipsList" Grid.Row="1" Margin="0,8" SelectionChanged="ClipsList_SelectionChanged"
                             AllowDrop="True" DragOver="ClipsList_DragOver" Drop="ClipsList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding ResolutionDisplay}"/><Run Text=" — "/><Run Text="{Binding DurationDisplay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding FrameRate, StringFormat={}{0:0.###} fps}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Move up" Click="MoveClipUp_Click"/>
                        <Button Content="Move down" Click="MoveClipDown_Click" Margin="0"/>
                    </StackPanel>
                    <GroupBox Grid.Row="3" Header="Cut selected clip" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TrimStartText" Grid.Column="1" Margin="0,0,8,6" LostFocus="TrimText_LostFocus"/>
                            <Button Grid.Column="2" Content="Set current" Click="SetTrimStart_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="End" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TrimEndText" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" LostFocus="TrimText_LostFocus"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Set current" Click="SetTrimEnd_Click" Margin="0,0,0,6"/>
                            <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Split at current frame" Click="SplitClip_Click" Margin="0,0,0,6"/>
                            <Button Grid.Row="3" Grid.ColumnSpan="3" Content="Reset cut" Click="ResetTrim_Click" Margin="0"/>
                        </Grid>
                    </GroupBox>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock x:Name="ResolutionSuggestionText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        <Button x:Name="ApplyResolutionSuggestionButton" Content="Use suggested target" Click="ApplyResolutionSuggestion_Click"
                                HorizontalAlignment="Left" Margin="0,7,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Reset crop" Click="ResetCrop_Click"/>
                    <Button Content="Centre selection" Click="CenterSelection_Click"/>
                    <TextBlock x:Name="SelectionInfoText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                    <TextBlock Text="Drag the box to move it; drag a handle to resize it." VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True"/>
                    <Button Content="Apply edits" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ApplyEdits_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
